{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voltra Controller",
  "version": "0.1.0",
  "identifier": "com.voltra.controller",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Voltra Controller",
        "width": 560,
        "height": 860,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3MDkzOTIyRjY0QzAzQTgKUldTb0EwejJJamtKeDU5S0xrQ3ZWRlBiMHhSemRRYzVRZXZ6bFZGdHFmbEgxQ3V2dTJKWXorQm4K",
      "endpoints": [
        "https://github.com/ibuilder/voltra/releases/latest/download/latest.json"
      ]
    }
  }
}
